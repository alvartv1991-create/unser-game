[internationalization]

locale/translations=PackedStringArray("res://localization/ui.de.translation", "res://localization/ui.en.translation", "res://localization/combat.de.translation", "res://localization/combat.en.translation", "res://localization/story.de.translation", "res://localization/story.en.translation", "res://localization/dialogue.en.translation")
locale/translations_pot_files=PackedStringArray("res://dialogue/test/hello.dialogue", "res://dialogue/area1/intro.dialogue", "res://dialogue/area1/raiders.dialogue", "res://dialogue/area1/cook.dialogue", "res://dialogue/area1/tinkerer.dialogue", "res://dialogue/area1/videostore.dialogue", "res://dialogue/area1/gate.dialogue", "res://dialogue/area1/alien_zone.dialogue", "res://dialogue/area1/cult.dialogue", "res://dialogue/examine.dialogue")
locale/fallback="de"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
